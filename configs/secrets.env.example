# VideoGuard — Пример файла с секретами
# Скопируйте этот файл в /etc/videoguard/secrets.env
# и заполните реальными значениями.

# Учётные данные камеры
CAM_USERNAME=your_camera_username
CAM_PASSWORD=your_camera_password

# Уведомления MAX (Telegram Bot API)
MAX_BOT_TOKEN=your_bot_token
MAX_CHAT_ID=your_chat_id
